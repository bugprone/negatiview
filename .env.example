# PostgreSQL (used by docker compose and by the server through DATABASE_URL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=negatiview
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/negatiview

# Redis (stores issued access tokens so they can be revoked)
REDIS_URL=redis://127.0.0.1:6379/

# JWT keys: base64-encoded RSA PEMs (RS256). Generate your own, see README.
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRES_IN=15
ACCESS_TOKEN_MAX_AGE=15
REFRESH_TOKEN_PRIVATE_KEY=
REFRESH_TOKEN_PUBLIC_KEY=
REFRESH_TOKEN_EXPIRES_IN=60
REFRESH_TOKEN_MAX_AGE=60
