  "query": "\n        SELECT display_name, biography, profile_image_url,\n            EXISTS (\n                SELECT 1 FROM user_follows\n                WHERE followee_user_id = users.id AND follower_user_id = $2\n            ) \"following!\"\n            FROM users\n            WHERE display_name = $1\n        ",
